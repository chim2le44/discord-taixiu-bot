{
  "name": "discord-taixiu-bot",
  "version": "1.0.0",
  "description": "Lightweight full-featured Discord Tai Xiu bot in TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/registerCommands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
